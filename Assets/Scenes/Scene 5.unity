  normalColor: {r: 1, g: 1, b: 1, a: 1}
  questions:
  - question: "What does the appearance of bright and dark fringes in Young\u2019s
      experiment prove?"
    options:
    - ' A. Light behaves only like particles'
    - ' B. Light behaves like waves'
    - ' C. The slits were not equal in size'
    - ' D. The lamp was too bright'
    correctIndex: 1
    correctVO: {fileID: 8300000, guid: f43ac7780b3a146469f1e3a5030c7024, type: 3}
  - question: 'A bright fringe is formed when the path difference is:'
    options:
    - " A. (2n + 1) \u03BB / 2"
    - ' B. Zero only'
    - " C. n\u03BB"
    - " D. 3\u03BB / 2"
    correctIndex: 2
    correctVO: {fileID: 8300000, guid: 01c108e0f2bdf0247a0c490488283da1, type: 3}
  - question: If we switch from blue light to red light, what happens to the fringe
      width?
    options:
    - ' A. It becomes narrower'
    - ' B. It becomes wider'
    - ' C. It remains the same'
    - ' D. Fringes disappear'
    correctIndex: 1
    correctVO: {fileID: 8300000, guid: 50b395846afaf4145accf2721341ee1c, type: 3}
  - question: To increase fringe width, what should we do?
    options:
    - ' A. Move the screen closer'
    - ' B. Move the screen farther'
    - ' C. Reduce wavelength'
    - ' D. Increase slit separation'
    correctIndex: 1
    correctVO: {fileID: 8300000, guid: 89be4239016fde34798f6a3bf11d34e2, type: 3}
  - question: 'Increasing the distance between the slits (d) will cause the fringes
      to:'
    options:
    - ' A. Spread farther apart'
    - ' B. Move closer together'
    - ' C. Become brighter'
    - ' D. Disappear completely'
    correctIndex: 1
    correctVO: {fileID: 8300000, guid: 78fee7c31b062664c9a6058aa7c3aa25, type: 3}
  audioSource: {fileID: 1765476568}
  wrongAnswerSFX: {fileID: 8300000, guid: a98fbf0a8a890f74c97f314efa3e5b11, type: 3}
  conclusionVO: {fileID: 8300000, guid: 1c7e2b3ae7fe7524aa3e05a5fd2b461b, type: 3}
